{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/skills/progress-dashboard/scripts/progress.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" hook session-start",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/kmz/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/skills/progress-dashboard/scripts/progress.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" hook stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/skills/progress-dashboard/scripts/progress.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" hook session-end",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/skills/progress-dashboard/scripts/progress.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" hook agent",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/skills/progress-dashboard/scripts/progress.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" hook agent",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/skills/progress-dashboard/scripts/progress.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" hook agent",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/skills/progress-dashboard/scripts/progress.py\"; [ -f \"$f\" ] || exit 0; ls \"$HOME\"/.local/state/progress-dashboard/agents/*.waiting >/dev/null 2>&1 && python3 \"$f\" hook agent || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt|permission_prompt|elicitation_dialog|elicitation_url_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/skills/progress-dashboard/scripts/progress.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" hook agent",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/skills/progress-dashboard/scripts/progress.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" hook agent",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 2
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  },
  "spinnerTipsEnabled": false,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "low"
    }
  },
  "advisorModel": "fable",
  "fastModePerSessionOptIn": true,
  "theme": "dark",
  "showMessageTimestamps": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
